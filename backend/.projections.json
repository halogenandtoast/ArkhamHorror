{
  "arkham-api/library/Arkham/Effect/Effects/*.hs": {
    "type": "effect",
    "alternate": "arkham-api/tests/Arkham/Effect/Effects/{}Spec.hs",
    "template": [
      "module Arkham.Effect.Effects.{dot}",
      "  ( {dot}(..)",
      "  , {dot|snakecase|camelcase}",
      "  ) where",
      "",
      "import Arkham.Prelude",
      "",
      "import Arkham.Classes",
      "import Arkham.Effect.Runner",
      "",
      "newtype {dot} = {dot} EffectAttrs",
      "  deriving anyclass HasAbilities",
      "  deriving newtype (Show, Eq, ToJSON, FromJSON, Entity)",
      "",
      "{dot|snakecase|camelcase} :: EffectArgs -> {dot}",
      "{dot|snakecase|camelcase} = {dot} . uncurry4 (baseAttrs \"TODO: ID\")",
      "",
      "instance HasModifiersFor {dot}",
      "",
      "instance RunMessage {dot} where",
      "  runMessage msg ({dot} attrs) =",
      "    {dot} <$> runMessage msg attrs"
    ]
  },
  "arkham-api/library/Arkham/Act/Cards/*.hs": {
    "type": "act",
    "alternate": "arkham-api/tests/Arkham/Act/Cards/{dirname}/{basename}Spec.hs",
    "template": [
      "module Arkham.Act.Cards.{dirname|dot}.{basename} ({basename|snakecase|camelcase}) where",
      "",
      "import Arkham.Act.CardDefs.{dirname|dot} qualified as Cards",
      "import Arkham.Act.Import.Lifted",
      "",
      "newtype {basename} = {basename} ActAttrs",
      "  deriving anyclass (IsAct, HasModifiersFor)",
      "  deriving newtype (Show, Eq, ToJSON, FromJSON, Entity, HasAbilities)",
      "",
      "{basename|snakecase|camelcase} :: ActCard {basename}",
      "{basename|snakecase|camelcase} = act (1, A) {basename} Cards.{basename|snakecase|camelcase} Nothing",
      "",
      "instance RunMessage {basename} where",
      "  runMessage msg a@({basename} attrs) = runQueueT $ case msg of",
      "    AdvanceAct (isSide B attrs -> True) _ _ -> do",
      "      advanceActDeck attrs",
      "      pure a",
      "    _ -> {basename} <$> liftRunMessage msg attrs"
    ]
  },
  "arkham-api/library/Arkham/Act/CardDefs/*.hs": {
    "type": "actdefs",
    "template": [
      "module Arkham.Act.CardDefs.{dirname|dot}.{basename} where",
      "",
      "import Arkham.Act.CardDefs.Import"
    ]
  },
  "arkham-api/library/Arkham/Scenario/Scenarios/*.hs": {
    "type": "scenario",
    "alternate": "arkham-api/tests/Arkham/Scenario/Scenarios/{dirname}/{basename}Spec.hs",
    "template": [
      "module Arkham.Scenario.Scenarios.{dirname|dot}.{basename} ({basename|snakecase|camelcase}) where",
      "",
      "import Arkham.EncounterSet qualified as Set",
      "import Arkham.Scenario.Import.Lifted",
      "import Arkham.Scenarios.{dirname|dot}.{basename}.Helpers",
      "",
      "newtype {basename} = {basename} ScenarioAttrs",
      "  deriving anyclass (IsScenario, HasModifiersFor)",
      "  deriving newtype (Show, Eq, ToJSON, FromJSON, Entity)",
      "",
      "{basename|snakecase|camelcase} :: Difficulty -> {basename}",
      "{basename|snakecase|camelcase} difficulty =",
      "  scenario {basename} \"TODO: ID\" \"TODO: NAME\" difficulty []",
      "",
      "instance HasChaosTokenValue {basename} where",
      "  getChaosTokenValue iid tokenFace ({basename} attrs) = case tokenFace of",
      "    Skull -> pure $ toChaosTokenValue attrs Skull 3 5",
      "    otherFace -> getChaosTokenValue iid otherFace attrs",
      "",
      "instance RunMessage {basename} where",
      "  runMessage msg s@({basename} attrs) = runQueueT $ scenarioI18n $ case msg of",
      "    Setup -> runScenarioSetup {basename} attrs do",
      "      gather Set.{basename}",
      "    _ -> {basename} <$> liftRunMessage msg attrs"
    ]
  },
  "arkham-api/library/Arkham/Scenarios/*/Helpers.hs": {
    "type": "scenariohelpers",
