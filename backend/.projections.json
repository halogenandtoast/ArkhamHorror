  "arkham-api/library/Arkham/Campaign/Campaigns/*.hs": {
    "type": "campaign",
    "alternate": "arkham-api/tests/Arkham/Campaign/Campaigns/{}Spec.hs",
    "template": [
      "module Arkham.Campaign.Campaigns.{dot} ({dot|snakecase|camelcase}) where",
      "",
      "import Arkham.Campaign.Import.Lifted",
      "-- import Arkham.Campaigns.{dot}.CampaignSteps",
      "-- import Arkham.Campaigns.{dot}.Helpers",
      "import Arkham.I18n",
      "",
      "newtype {dot} = {dot} CampaignAttrs",
      "  deriving newtype (Show, Eq, ToJSON, FromJSON, Entity, HasModifiersFor)",
      "",
      "{dot|snakecase|camelcase} :: Difficulty -> {dot}",
      "{dot|snakecase|camelcase} = campaign {dot} (CampaignId \"TODO: ID\") \"{basename|snakecase|capitalize|blank}\"",
      "",
      "instance IsCampaign {dot} where",
      "  campaignTokens = const [] -- TODO implement Difficulty -> [ChaosTokenFace]",
      "  nextStep a = case campaignStep (toAttrs a) of",
      "    PrologueStep -> Nothing",
      "    EpilogueStep -> Nothing",
      "    UpgradeDeckStep nextStep' -> Just nextStep'",
      "    _ -> Nothing",
      "",
      "-- TODO: Extract this to Arkham.Campaigns.{dot}.Helpers",
      "{-",
      "module Arkham.Campaigns.{dot}.Helpers where",
      "",
      "import Arkham.I18n",
      "import Arkham.Prelude",
      "import Arkham.Prelude",
      "",
      "campaignI18n :: (HasI18n => a) -> a",
      "campaignI18n a = withI18n $ scope \"{dot|snakecase|camelcase}\" a",
      "-}",
      "",
      "campaignI18n :: (HasI18n => a) -> a",
      "campaignI18n a = withI18n $ scope \"{dot|snakecase|camelcase}\" a",
      "",
      "instance RunMessage {dot} where",
      "  runMessage msg c@({dot} _attrs) = runQueueT $ campaignI18n $ case msg of",
      "    CampaignStep PrologueStep -> do",
      "      pure c",
      "    _ -> lift $ defaultCampaignRunner msg c"
    ]
  },
