  "arkham-api/library/Arkham/Homebrew/*/Campaign.hs": {
    "type": "hbcampaign",
    "template": [
      "module Arkham.Homebrew.{dot}.Campaign ({|snakecase|camelcase}) where",
      "",
      "import Arkham.Campaign.Import.Lifted",
      "import Arkham.Homebrew.{dot}.CampaignSteps",
      "import Arkham.Homebrew.{dot}.Import",
      "",
      "newtype {dot} = {dot} CampaignAttrs",
      "  deriving newtype (Show, Eq, ToJSON, FromJSON, Entity, HasModifiersFor)",
      "",
      "{|snakecase|camelcase} :: Difficulty -> {dot}",
      "{|snakecase|camelcase} = campaign {dot} (CampaignId \":{|snakecase|hyphenate}\") \"{|snakecase|blank|capitalize}\"",
      "",
      "instance IsCampaign {dot} where",
      "  campaignTokens = chaosBagContents",
      "  nextStep a = case (toAttrs a).normalizedStep of",
      "    PrologueStep -> Nothing",
      "    EpilogueStep -> Nothing",
      "    UpgradeDeckStep nextStep' -> Just nextStep'",
      "    _ -> Nothing",
      "",
      "instance RunMessage {dot} where",
      "  runMessage msg c@({dot} _attrs) = runQueueT $ campaignI18n $ case msg of",
      "    CampaignStep PrologueStep -> do",
      "      pure c",
      "    _ -> lift $ defaultCampaignRunner msg c"
    ]
  },
  "arkham-api/library/Arkham/Homebrew/**/Scenarios/*.hs": {
    "type": "hbscenario",
    "alternate": "arkham-api/tests/Arkham/Homebrew/{dirname}/Scenarios/{basename}Spec.hs",
    "template": [
      "module Arkham.Homebrew.{dirname|dot}.Scenarios.{basename} ({basename|snakecase|camelcase}) where",
      "",
      "import Arkham.Homebrew.{dirname|dot}.CardDefs.Acts qualified as Acts",
      "import Arkham.Homebrew.{dirname|dot}.CardDefs.Agendas qualified as Agendas",
      "import Arkham.Homebrew.{dirname|dot}.CardDefs.Locations qualified as Locations",
      "import Arkham.Homebrew.{dirname|dot}.Helpers",
      "import Arkham.Homebrew.{dirname|dot}.Sets qualified as Set",
      "import Arkham.Scenario.Import.Lifted",
      "",
      "newtype {basename} = {basename} ScenarioAttrs",
      "  deriving anyclass (IsScenario, HasModifiersFor)",
      "  deriving newtype (Show, Eq, ToJSON, FromJSON, Entity)",
      "",
      "{basename|snakecase|camelcase} :: Difficulty -> {basename}",
      "{basename|snakecase|camelcase} difficulty =",
      "  scenario {basename} \":{dirname|snakecase|hyphenate}:TODO\" \"TODO: NAME\" difficulty []",
      "",
      "instance HasChaosTokenValue {basename} where",
      "  getChaosTokenValue iid tokenFace ({basename} attrs) = case tokenFace of",
      "    Skull -> pure $ toChaosTokenValue attrs Skull 1 2",
      "    otherFace -> getChaosTokenValue iid otherFace attrs",
      "",
      "instance RunMessage {basename} where",
      "  runMessage msg s@({basename} attrs) = runQueueT $ scenarioI18n \"{basename|snakecase|camelcase}\" $ case msg of",
      "    Setup -> runScenarioSetup {basename} attrs do",
      "      gather Set.{basename}",
      "      setAgendaDeck [Agendas.todo]",
      "      setActDeck [Acts.todo]",
      "      startAt =<< place Locations.todo",
      "    ScenarioResolution _ -> do",
      "      endOfScenario",
      "      pure s",
      "    _ -> {basename} <$> liftRunMessage msg attrs"
    ]
  },
