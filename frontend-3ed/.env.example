# Where card/tile/token images load from: ${VITE_ASSET_HOST}/img/ah3e/...
# Unset: https://assets.arkhamhorror.app. Empty: same origin (in dev Vite
# serves public/img/ah3e). A non-null assetHost from the API's
# /api/v1/site-settings overrides this at startup.
VITE_ASSET_HOST=

# Domain of the shared sign-in cookie `arkham-token`, e.g. .arkhamhorror.app.
# Leave unset locally: a localhost cookie is already shared across ports.
VITE_AUTH_COOKIE_DOMAIN=

# The main site, linked for signing in. Defaults to https://arkhamhorror.app in
# production builds and http://localhost:8080 in dev.
VITE_MAIN_SITE_URL=
