{
  "type": "module",
  "name": "arkhamhorror",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "serve": "vite serve",
    "prebuild": "node ./scripts/slim-cards.cjs",
    "build": "vite build",
    "postbuild": "node ./scripts/precompress.cjs",
    "precompress": "node ./scripts/precompress.cjs",
    "tc": "vue-tsc --noEmit -p tsconfig.json --composite false",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,vue}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\"",
    "test": "node --test tests/*.test.mjs",
    "digest": "node ./scripts/digest.cjs",
    "fetch-card-data": "node ./scripts/fetch-card-data.cjs --slim",
    "import-fr-cards": "node ./scripts/import-card-translations.cjs --source-locale fr --output-lang fr --slim",
    "import-zh-cn-cards": "node ./scripts/import-card-translations.cjs --source-locale zh-cn --output-lang zh-cn --slim",
    "slim-cards": "node ./scripts/slim-cards.cjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@vueuse/components": "^13.9.0",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.12.2",
    "floating-vue": "^5.2.2",
    "gsap": "^3.13.0",
    "lottie-web-vue": "^2.0.7",
    "mitt": "^3.0.1",
    "pinia": "^4.1.0",
    "ts.data.json": "^3.1.1",
    "v-jsoneditor": "^1.4.5",
    "vue": "^3.5.22",
    "vue-final-modal": "^4.5.5",
    "vue-i18n": "^11.1.12",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.6.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "^10.5.0",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.93.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
