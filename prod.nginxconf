events {}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  # How long each class of asset may be cached.
  #
  # Vite emits content-hashed filenames under /assets/, so those bytes can
  # never change behind a URL — they get a year and `immutable`, which also
  # tells the browser not to revalidate on reload. Card images are addressed by
  # card code and are equally stable in practice, but aren't hash-named, so
  # they get a long TTL without `immutable`.
  #
  # Everything else revalidates. index.html especially: it names the hashed
  # bundles, so a stale copy points at asset URLs that no longer exist.
  map $uri $cache_control {
    default            "public, max-age=0, must-revalidate";
    "~^/assets/"       "public, max-age=31536000, immutable";
    "~^/img/"          "public, max-age=2592000";
    "~^/audio/"        "public, max-age=2592000";
  }

  # Does this client accept brotli? Matched as a whole word so it can't be
  # fooled by a token like "brotli-ish" or a future "xbr".
  map $http_accept_encoding $accepts_br {
    default      0;
    "~*(^|,)\s*br\s*(;|,|$)" 1;
  }

  gzip on;
  gzip_static on;
  gzip_vary on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types
    application/json
    application/javascript
    application/xml
    application/rss+xml
    application/atom+xml
    application/wasm
    image/svg+xml
    text/css
    text/javascript
    text/plain
    text/xml;

  server {
    listen 3000;
    server_name .arkhamhorror.app;
    client_max_body_size 5M;

    root /opt/arkham/src/frontend/dist;

    # Precompressed static delivery for the two directories the build fully
    # controls (scripts/precompress.cjs writes a .gz and a .br next to every
    # file in them). Ubuntu's nginx has no brotli module and nginx.org doesn't
    # package one, so brotli is served by hand:
    #
    #   client accepts br + .br exists -> rewrite to it, tag Content-Encoding
    #   client accepts gzip            -> gzip_static serves the .gz
    #   neither                        -> the raw file
    #
    # The `-f` test is what makes this safe. Content-Encoding is only ever set
    # on a request that is actually being answered with the .br file, so a file
    # the build skipped just falls through to gzip rather than being mislabeled.
    #
    # `gzip off` matters here: dynamic gzip would otherwise re-compress the
    # brotli bytes, because add_header sets Content-Encoding too late in the
    # filter chain for the gzip module to notice. gzip_static is a separate
    # module and keeps working with gzip off.
    #
    # These are split per extension because after the rewrite the filename ends
    # in .br, which isn't in mime.types — default_type supplies the real type.
    location ~* ^/assets/.+\.js$ {
      default_type application/javascript;
      gzip off;

      set $br "";
      if ($accepts_br) { set $br "y"; }
      if (-f "$request_filename.br") { set $br "${br}f"; }
      if ($br = "yf") {
        add_header Cache-Control $cache_control always;
        add_header Vary "Accept-Encoding" always;
        add_header Content-Encoding "br" always;
        rewrite ^(.*)$ $1.br break;
      }

      add_header Cache-Control $cache_control always;

      # A name that isn't in this image isn't necessarily wrong -- see
      # @cdn_assets. Try the CDN before answering 404.
      try_files $uri @cdn_assets;
    }

    location ~* ^/assets/.+\.css$ {
      default_type text/css;
      gzip off;

      set $br "";
      if ($accepts_br) { set $br "y"; }
      if (-f "$request_filename.br") { set $br "${br}f"; }
      if ($br = "yf") {
        add_header Cache-Control $cache_control always;
        add_header Vary "Accept-Encoding" always;
        add_header Content-Encoding "br" always;
        rewrite ^(.*)$ $1.br break;
      }

      add_header Cache-Control $cache_control always;

      # A name that isn't in this image isn't necessarily wrong -- see
      # @cdn_assets. Try the CDN before answering 404.
      try_files $uri @cdn_assets;
    }

    # The slimmed card database, ~6 MB of JSON per locale and the single
    # biggest thing a cold client downloads. Not content-hashed, so it
    # revalidates via ETag rather than caching immutably.
    location ~* ^/cards/.+\.json$ {
      default_type application/json;
      gzip off;

      set $br "";
      if ($accepts_br) { set $br "y"; }
      if (-f "$request_filename.br") { set $br "${br}f"; }
      if ($br = "yf") {
        add_header Cache-Control $cache_control always;
        add_header Vary "Accept-Encoding" always;
        add_header Content-Encoding "br" always;
        rewrite ^(.*)$ $1.br break;
      }

      add_header Cache-Control $cache_control always;
    }

    # Everything else the build emits under /assets/ -- fonts, and any image
    # small enough that vite emitted a file rather than a data: URI. A plain
    # prefix, not `^~`, so the two regex locations above still get first refusal.
    #
    # This exists mostly so a miss can't reach `location /` below, where
    # try_files would answer with index.html: a font or an image arriving as 200
    # OK with a page of HTML in it fails in ways that look nothing like the 404
    # it actually is.
    location /assets/ {
      add_header Cache-Control $cache_control always;
      try_files $uri @cdn_assets;
    }

    # An /assets/ file this pod's image does not contain.
    #
    # Bundle names are content-hashed, so they differ between builds, and every
    # pod serves /assets/ out of its own image. Two routine situations therefore
    # ask a pod for a name it has never heard of: during a rolling update the
    # load balancer's backend pool holds the old build and the new one at once,
    # and a tab left open across a deploy goes on importing route chunks from the
    # build it was loaded with. Without this, the first is a 404 on the entry
    # chunk -- a blank page, with no JS left running to recover from it.
    #
    # Every deploy uploads its bundles to the CDN bucket and never deletes what
    # is already there (scripts/publish-frontend-assets.sh), so the CDN holds the
    # union of every build that has shipped and can answer for any pod.
    #
    # proxy_pass carries no URI part on purpose: that forwards the request URI
    # unchanged, and keeps the host literal. A variable in proxy_pass would
    # switch nginx to runtime resolution and need a `resolver`, which is one more
    # thing to be wrong at 3am.
    #
    # Cache-Control is deliberately NOT overridden here. The uploads set
    # `immutable` on the objects themselves, and letting the CDN's own headers
    # through means a 404 from it stays short-lived instead of being cached for a
    # year by a browser that asked a few seconds too early.
    location @cdn_assets {
      proxy_pass https://assets.arkhamhorror.app;
      proxy_set_header Host assets.arkhamhorror.app;
      # CloudFront requires SNI, and nginx does not send it unless told to.
      proxy_ssl_server_name on;
      proxy_http_version 1.1;
      proxy_set_header Connection "";

      # A public bundle has nothing to do with who is asking, and the LB's
      # affinity cookie would only fragment the CDN cache.
      proxy_set_header Cookie "";
      proxy_set_header Authorization "";
      proxy_hide_header Set-Cookie;

      add_header X-Asset-Fallback "cdn" always;

      # Short: this is already the slow path, and a hanging CDN must not hold a
      # worker connection open behind a bundle the client could re-request.
      proxy_connect_timeout 3s;
      proxy_read_timeout 10s;
    }

    location / {
      try_files $uri $uri/ /index.html;
      add_header Cache-Control $cache_control always;
    }

    # ^~ so the regex locations above can't intercept an API path.
    location ^~ /api {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_pass_request_headers      on;
        proxy_pass http://localhost:3002;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        add_header P3P 'CP="ALL DSP COR PSAa PSDa OUR NOR ONL UNI COM NAV"';
    }

    location ^~ /health {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_pass_request_headers      on;
        proxy_pass http://localhost:3002;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        add_header P3P 'CP="ALL DSP COR PSAa PSDa OUR NOR ONL UNI COM NAV"';
    }

    # The custom-card MCP server (start.sh, loopback :8420). ^~ for the same
    # reason /api needs it: the regex locations above must not intercept it.
    #
    # Authorization is forwarded explicitly. nginx does pass it by default, but it
    # is the entire authentication mechanism here and a stray `proxy_set_header
    # Authorization ""` anywhere would turn every request into a 401 with nothing
    # to say why -- so it is written down.
    location ^~ /mcp {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_redirect off;
        proxy_pass_request_headers      on;
        proxy_pass http://localhost:8420;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;

        # A card def is small; art is uploaded through the web app, not here.
        client_max_body_size 4m;

        # Off so a future server-sent stream is not buffered into uselessness.
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
  }

  # Third edition (frontend-3ed), sharing the API. The exact name wins over the
  # .arkhamhorror.app wildcard above, which stays the default server. 3001 is
  # for docker-compose, where there's no hostname to route on.
  server {
    listen 3000;
    listen 3001;
    server_name 3ed.arkhamhorror.app;
    client_max_body_size 1M;

    root /opt/arkham/src/frontend-3ed/dist;

    location ^~ /assets/ {
      add_header Cache-Control $cache_control always;
      try_files $uri @cdn_assets;
    }

    # See the @cdn_assets in the server above; named locations are per-server, so
    # 3ed needs its own copy of it.
    location @cdn_assets {
      proxy_pass https://assets.arkhamhorror.app;
      proxy_set_header Host assets.arkhamhorror.app;
      proxy_ssl_server_name on;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Cookie "";
      proxy_set_header Authorization "";
      proxy_hide_header Set-Cookie;
      add_header X-Asset-Fallback "cdn" always;
      proxy_connect_timeout 3s;
      proxy_read_timeout 10s;
    }

    # images come from the CDN unless docker-compose mounted them here; a
    # missing one must 404, not fall through to index.html
    location ^~ /img/ {
      try_files $uri =404;
      add_header Cache-Control $cache_control always;
    }

    location / {
      try_files $uri $uri/ /index.html;
      add_header Cache-Control $cache_control always;
    }

    location ^~ /api {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_pass_request_headers      on;
        proxy_pass http://localhost:3002;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location ^~ /health {
        proxy_pass http://localhost:3002;
    }
  }
}
